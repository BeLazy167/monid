                    "language": "en",
                    "tts": {
                        "voiceId": "voice-1"
                    },
                    "llm": {
                        "model": "openai/gpt-4o"
                    },
                    "complianceEnabled": true,
                    "manualSecret": "sec-never-leaks"
                }
            }
        }
    ]
}
